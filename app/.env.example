# --- SerpApi (official-source discovery) -------------------------------------
SERPAPI_API_KEY=

# --- Xano (system of record) -------------------------------------------------
# Workspace 2 = "accessform". Workspace 1 is a different project; do not use it.
XANO_BASE_URL=
XANO_API_KEY=

# --- Nutrient DWS ------------------------------------------------------------
# Verified 2026-09-02: there is NO single Nutrient key and the paths are fixed.
# Each key is scoped to its own product path and returns 403 on the others.
#   NUTRIENT_DWS_PROCESSOR_API   -> POST https://api.nutrient.io/build
#   NUTRIENT_DATA_EXTRACTION_API -> POST https://api.nutrient.io/extraction/parse
#   NUTRIENT_ACCESSIBILITY_API   -> POST https://api.nutrient.io/accessibility/autotag
NUTRIENT_DWS_PROCESSOR_API=
NUTRIENT_DATA_EXTRACTION_API=
NUTRIENT_ACCESSIBILITY_API=

# Publishable (pdf_pub_live_...). Browser-side viewer only; 401s on the REST API.
NEXT_PUBLIC_NUTRIENT_VIEWER_KEY=

# --- Vapi (voice) ------------------------------------------------------------
VAPI_PRIVATE_KEY=
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# --- Document engine ---------------------------------------------------------
# local    = fill + flatten the official PDF with pdf-lib on this server. No paid
#            API, no evaluation watermark; the source document's own accessibility
#            tagging is preserved (status "preserved"). This is the default.
# nutrient = POST /build + /accessibility/autotag on api.nutrient.io. Needs credit
#            on the account and NUTRIENT_DWS_PROCESSOR_API; otherwise falls back to local.
DOCUMENT_ENGINE=local

# --- Demo behaviour ----------------------------------------------------------
# true  = use cached/fixture discovery, never spend SerpApi credits
# false = run live SerpApi discovery
NEXT_PUBLIC_DEMO_MODE=true

# OpenAI (judgment steps)
OPENAI_API_KEY=
# Twilio (SMS delivery)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Approve and send (email to the program) ---------------------------------
# Nothing is emailed unless BOTH are set. Without them POST /api/delivery/email
# records the approval and a "skipped: no_provider" delivery, never "sent".
RESEND_API_KEY=
SUBMISSION_FROM_EMAIL=
# Optional JSON map of program id -> intake email, used when the program's
# submission_instructions carry no address. Example: {"1":"billing@example.org"}
SUBMISSION_EMAIL_OVERRIDES=
